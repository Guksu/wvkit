{
  "name": "@wvkit/core",
  "version": "0.0.0",
  "description": "WebView 헤드리스 UI — Vanilla JS 코어",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "three": "^0.184.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "three": "^0.184.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
