{
  "name": "@guksu/wvkit-core",
  "version": "0.3.1",
  "description": "Headless UI primitives for WebView — framework-agnostic core (Vanilla JS)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scroll-container": {
      "types": "./dist/scroll-container.d.ts",
      "import": "./dist/scroll-container.js",
      "require": "./dist/scroll-container.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "author": {
    "name": "Guksu",
    "url": "https://github.com/Guksu"
  },
  "homepage": "https://github.com/Guksu/wvkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guksu/wvkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Guksu/wvkit/issues"
  },
  "keywords": [
    "webview",
    "headless",
    "ui",
    "scroll",
    "scroll-container",
    "pull-to-refresh",
    "stable-input",
    "safe-area",
    "virtual-keyboard",
    "ios",
    "android",
    "wkwebview",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "three": "^0.184.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
