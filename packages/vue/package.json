{
  "name": "@wvkit/vue",
  "version": "0.1.0",
  "description": "Headless UI primitives for WebView — Vue 3 adapter (composables + renderless components)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "license": "MIT",
  "author": {
    "name": "Guksu",
    "url": "https://github.com/Guksu"
  },
  "homepage": "https://github.com/Guksu/wvkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guksu/wvkit.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Guksu/wvkit/issues"
  },
  "keywords": [
    "webview",
    "headless",
    "vue",
    "vue3",
    "composables",
    "scroll",
    "pull-to-refresh",
    "stable-input",
    "safe-area",
    "virtual-keyboard",
    "ios",
    "android",
    "wkwebview",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wvkit/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
