{
  "name": "@guksu/wvkit-react",
  "version": "0.2.0",
  "description": "Headless UI primitives for WebView — React adapter (hooks + components)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "license": "MIT",
  "author": {
    "name": "Guksu",
    "url": "https://github.com/Guksu"
  },
  "homepage": "https://github.com/Guksu/wvkit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guksu/wvkit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Guksu/wvkit/issues"
  },
  "keywords": [
    "webview",
    "headless",
    "react",
    "hooks",
    "scroll",
    "pull-to-refresh",
    "stable-input",
    "safe-area",
    "virtual-keyboard",
    "ios",
    "android",
    "wkwebview",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@guksu/wvkit-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
